# Neon pooled connection string. The host must contain "-pooler".
# Neon dashboard → Connect → Pooled connection.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Direct (unpooled) connection for the Python worker. Not used in step 1.
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require

# Phase D LLM keys are loaded by the Python worker from this file (or engine/.env).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it
# LLM_PROVIDER=openrouter
# GROQ_API_KEY=

# Phase G — GitHub App (worker + web)
# GITHUB_APP_ENABLED=true
# GITHUB_APP_MODE=mock
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_WEBHOOK_SECRET=

# Phase I — scheduler tick (POST /api/internal/scheduler/tick)
# CRON_SECRET=generate-a-long-random-string
# PYTHON_PATH=python
