# Direct Neon connection for the Python worker (no -pooler).
# Falls back to DATABASE_URL if unset.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require

# Optional: same pooled URL as web/.env.local (used when DATABASE_URL_DIRECT is empty)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Claim lock expiry before a running job can be retried (minutes)
JOB_LOCK_MINUTES=15
MAX_JOB_ATTEMPTS=3
POLL_INTERVAL_SECONDS=1.0

# Phase D — optional LLM explanations (scan still works if unset)
# LLM_ENABLED=true
# LLM_PROVIDER=auto
# Prefer free/low-cost providers already in use; do not hardcode keys.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# LLM_TIMEOUT_SECONDS=25
# LLM_MAX_RETRIES=2
# LLM_MAX_TOKENS=2500
# LLM_MAX_FINDINGS_PER_SCAN=8
# For tests: LLM_PROVIDER=mock

# Phase E — allow ownership HTTP verify against localhost fixtures (dev/test only)
# OWNERSHIP_ALLOW_LOOPBACK=true
