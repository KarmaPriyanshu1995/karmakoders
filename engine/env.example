# Direct Neon connection for the Python worker (no -pooler).
# Falls back to DATABASE_URL if unset.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require

# Optional: same pooled URL as web/.env.local (used when DATABASE_URL_DIRECT is empty)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Claim lock expiry before a running job can be retried (minutes)
JOB_LOCK_MINUTES=15
MAX_JOB_ATTEMPTS=3
POLL_INTERVAL_SECONDS=1.0

# Phase D — optional LLM explanations (scan still works if unset)
# LLM_ENABLED=true
# LLM_PROVIDER=auto
# Prefer free/low-cost providers already in use; do not hardcode keys.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# LLM_PROVIDER=openrouter
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# Claude (Anthropic) — add the key once, then switch provider/model from
# Admin → Platform · AI Provider (DB overrides win over these env values).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
# LLM_TIMEOUT_SECONDS=25
# LLM_MAX_RETRIES=2
# LLM_MAX_TOKENS=2500
# LLM_MAX_FINDINGS_PER_SCAN=8
# For tests: LLM_PROVIDER=mock

# Phase E — allow ownership HTTP verify against localhost fixtures (dev/test only)
# OWNERSHIP_ALLOW_LOOPBACK=true

# Phase G — GitHub App / authorized repo scans
# GITHUB_APP_ENABLED=true
# GITHUB_APP_MODE=mock
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=

# Phase I — enqueue-only scheduler (python scheduler.py [--once])
# SCHEDULER_POLL_SECONDS=60
# GITHUB_PAT_DEV=   # development-only fallback; never default in production
# GITHUB_MOCK_FIXTURE_PATH=
# REPO_MAX_ARCHIVE_BYTES=40000000
# REPO_MAX_EXTRACT_BYTES=80000000
# REPO_MAX_FILES=4000
# REPO_MAX_FILE_BYTES=1500000
# REPO_MAX_RUNTIME_SECONDS=180

# DISC_MAX_PAGES=80
# DISC_MAX_DEPTH=4
# DISC_MAX_CONCURRENCY=3
# DISC_MAX_REQUESTS=200
# DISC_MAX_RESPONSE_BYTES=512000
# DISC_MAX_JS_BYTES=1500000
# DISC_MAX_SOURCEMAP_BYTES=2000000
# DISC_MAX_TOTAL_BYTES=8000000
# DISC_MAX_RUNTIME_SECONDS=90
# DISC_REQUEST_TIMEOUT=8
# DISC_MAX_REDIRECTS=3
# DISC_MAX_WORDLIST=40
# DISC_MAX_JS_ASSETS=25
# DISC_MAX_PARAMS=30
# FUZZ_MAX_CASES=60
# FUZZ_MAX_ENDPOINTS=40

# API Security (Phase 3A foundation + 3B passive analysis; default off). When on, a
# verified-ownership URL scan converts the attack-surface inventory into an API
# inventory, runs deterministic passive checks, saves POTENTIAL findings through the
# existing findings pipeline and records one event. No API requests are sent.
# API_SECURITY_ENABLED=false
# API_SECURITY_MAX_ENDPOINTS=500
# API_SECURITY_MAX_SPEC_BYTES=5000000
# API_SECURITY_MAX_PAYLOAD_BYTES=64000
#
# API Security active testing (Phase 3C; default off, independent of the flag above).
# When on AND a scan supplies authorized test identities AND ownership is verified, the
# scanner runs behavioural authentication/BOLA/BFLA/BOPLA/JWT checks (and, only with the
# caller's explicit opt-in, mass-assignment) as bounded, scope-enforced, redirect-blocked
# requests to operator-supplied test objects on the verified host. Test credentials are
# held in memory only and never persisted. Off → no active API request is ever sent.
# API_SECURITY_ACTIVE_ENABLED=false
