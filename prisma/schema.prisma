generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ===========================
// PLATFORM / MULTI-TENANCY
// ===========================

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  TENANT_ADMIN
  MANAGER
  EDITOR
  AUTHOR
  HR
  EMPLOYEE
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  isPrimary Boolean      @default(false)
  logo      String?
  email     String?
  phone     String?
  website   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships           Membership[]
  pages                 Page[]
  projects              Project[]
  posts                 Post[]
  contactSubmissions    ContactSubmission[]
  newsletterSubscribers NewsletterSubscriber[]
  jobOpenings           JobOpening[]
  jobApplications       JobApplication[]
  siteConfigs           SiteConfig[]
  media                 Media[]
  auditLogs             AuditLog[]

  seoPages                SeoPage[]
  seoEntities             SeoEntity[]
  seoClusters             SeoCluster[]
  seoAudits               SeoAudit[]
  seoInternalLinks        SeoInternalLink[]
  seoSchemas              SeoSchema[]
  seoReports              SeoReport[]
  seoIssues               SeoIssue[]
  seoKeywordOpportunities SeoKeywordOpportunity[]
  seoCtrReports           SeoCtrReport[]
  seoContentGaps          SeoContentGap[]
  seoBrand                SeoBrand[]
  seoSearchConsole        SeoSearchConsole[]
  seoAutomationLogs       SeoAutomationLog[]

  @@index([status])
}

model Membership {
  id        String            @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole    @default(TENANT_ADMIN)
  status    MembershipStatus  @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

// ===========================
// AUTH
// ===========================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  isSuperAdmin  Boolean   @default(false)
  role          String    @default("USER")
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  auditLogs     AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===========================
// TENANT-OWNED CONTENT
// ===========================

model SiteConfig {
  id        String   @id @default(cuid())
  tenantId  String
  key       String   // e.g. "theme", "seoMeta"
  value     String   // JSON stringified
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Page {
  id          String    @id @default(cuid())
  tenantId    String
  slug        String
  title       String
  sections    Section[]
  isPublished Boolean   @default(false)
  seoMeta     String?   // JSON stringified

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Section {
  id      String @id @default(cuid())
  pageId  String
  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type    String
  content String // JSON stringified
  order   Int

  @@index([pageId])
}

model Project {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  slug        String
  description String
  imageUrl    String
  content     String
  link        String?
  tags        String   // CSV string (e.g. "react,nextjs")
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Post {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  slug      String
  excerpt   String?
  content   String
  image     String?
  category  String?
  author    String?
  type      String   @default("blog") // "blog" or "case-study"
  published Boolean  @default(false)
  seoMeta   String?  // JSON stringified
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

model JobOpening {
  id           String   @id @default(cuid())
  tenantId     String
  title        String
  slug         String
  department   String?
  location     String?
  type         String   @default("Full-time")
  description  String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  applications JobApplication[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model JobApplication {
  id          String   @id @default(cuid())
  tenantId    String
  jobId       String
  job         JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  portfolio   String?
  cvUrl       String
  coverLetter String?
  status      String   @default("Pending") // Pending, Reviewed, Interview, Rejected, Hired
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([jobId])
}

model Media {
  id           String   @id @default(cuid())
  tenantId     String
  url          String
  key          String?
  name         String
  size         Int?
  mimeType     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ===========================
// AUDIT LOG
// ===========================

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  resource   String?
  resourceId String?
  metadata   String?  // JSON stringified
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ===========================
// SEO INTELLIGENCE CENTER
// ===========================

model SeoPage {
  id                  String   @id @default(cuid())
  tenantId            String
  pageType            String   // "page" | "post" | "project"
  pageId              String   // references Page.id, Post.id, or Project.id
  url                 String
  title               String?
  metaTitle           String?
  metaDescription     String?
  h1                  String?
  headingsJson        String?  // JSON array of headings
  wordCount           Int      @default(0)
  readabilityScore    Float    @default(0)
  keywordDensityJson  String?  // JSON object
  internalLinksCount  Int      @default(0)
  externalLinksCount  Int      @default(0)
  imagesCount         Int      @default(0)
  imagesWithAlt       Int      @default(0)
  hasFaq              Boolean  @default(false)
  hasSchema           Boolean  @default(false)
  schemaTypes         String?  // CSV of schema types
  contentScore        Float    @default(0)
  technicalScore      Float    @default(0)
  entityScore         Float    @default(0)
  internalLinkScore   Float    @default(0)
  schemaScore         Float    @default(0)
  ctrScore            Float    @default(0)
  overallScore        Float    @default(0)
  issuesJson          String?  // JSON array of issues
  recommendationsJson String?  // JSON array of recommendations
  isIndexed           Boolean  @default(true)
  isOrphan            Boolean  @default(false)
  lastAnalyzed        DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, pageType, pageId])
  @@index([tenantId])
  @@map("seo_pages")
}

model SeoEntity {
  id          String   @id @default(cuid())
  tenantId    String
  type        String   // "brand" | "person" | "service" | "product" | "location" | "topic" | "keyword"
  name        String
  description String?
  aliases     String?  // CSV of alternate names
  sitewide    Boolean  @default(false)
  pagesJson   String?  // JSON array of page IDs where this entity appears
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("seo_entities")
}

model SeoCluster {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  slug             String
  pillarPageId     String?
  childPagesJson   String?  // JSON array of SeoPage.ids
  keywords         String?  // CSV
  topicsJson       String?  // JSON array
  healthScore      Float    @default(0)
  authorityScore   Float    @default(0)
  missingTopics    String?  // JSON array
  suggestedContent String?  // JSON array
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("seo_clusters")
}

model SeoAudit {
  id                    String   @id @default(cuid())
  tenantId              String
  runAt                 DateTime @default(now())
  totalPages            Int      @default(0)
  indexedPages          Int      @default(0)
  nonIndexedPages       Int      @default(0)
  brokenPages           Int      @default(0)
  brokenLinks           Int      @default(0)
  missingTitles         Int      @default(0)
  duplicateTitles       Int      @default(0)
  missingDescriptions   Int      @default(0)
  duplicateDescriptions Int      @default(0)
  missingH1             Int      @default(0)
  multipleH1            Int      @default(0)
  missingAlt            Int      @default(0)
  orphanPages           Int      @default(0)
  missingSchema         Int      @default(0)
  overallScore          Float    @default(0)
  technicalScore        Float    @default(0)
  contentScore          Float    @default(0)
  issuesSummaryJson     String?
  status                String   @default("complete")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("seo_audits")
}

model SeoInternalLink {
  id          String   @id @default(cuid())
  tenantId    String
  fromPageId  String
  toPageId    String
  anchorText  String?
  url         String
  isBroken    Boolean  @default(false)
  isSuggested Boolean  @default(false)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([fromPageId])
  @@index([toPageId])
  @@map("seo_internal_links")
}

model SeoSchema {
  id         String   @id @default(cuid())
  tenantId   String
  pageType   String
  pageId     String
  schemaType String
  schemaJson String
  isValid    Boolean  @default(true)
  errorsJson String?
  isApplied  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("seo_schema")
}

model SeoReport {
  id          String   @id @default(cuid())
  tenantId    String
  type        String   @default("weekly")
  title       String
  summaryJson String
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("seo_reports")
}

model SeoIssue {
  id          String    @id @default(cuid())
  tenantId    String
  pageType    String?
  pageId      String?
  url         String?
  type        String
  severity    String    // "critical" | "important" | "recommended"
  description String
  suggestion  String?
  isFixed     Boolean   @default(false)
  fixedAt     DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([pageId])
  @@index([severity])
  @@index([isFixed])
  @@map("seo_issues")
}

model SeoKeywordOpportunity {
  id                  String   @id @default(cuid())
  tenantId            String
  keyword             String
  pageId              String?
  url                 String?
  currentPosition     Float?
  impressions         Int      @default(0)
  clicks              Int      @default(0)
  ctr                 Float    @default(0)
  positionBucket      String?  // "4-10" | "11-20" | "21-50"
  opportunityScore    Float    @default(0)
  trafficOpportunity  Int      @default(0)
  recommendationsJson String?
  dataSource          String   @default("search_console")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("seo_keyword_opportunities")
}

model SeoCtrReport {
  id                  String   @id @default(cuid())
  tenantId            String
  pageId              String?
  url                 String
  currentTitle        String?
  currentDescription  String?
  avgPosition         Float    @default(0)
  impressions         Int      @default(0)
  clicks              Int      @default(0)
  ctr                 Float    @default(0)
  expectedCtr         Float    @default(0)
  suggestedTitlesJson String?
  suggestedDescsJson  String?
  ctrImprovementScore Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("seo_ctr_reports")
}

model SeoContentGap {
  id          String   @id @default(cuid())
  tenantId    String
  type        String   // "topic" | "keyword" | "faq" | "entity" | "service" | "subtopic"
  gap         String
  description String?
  priority    String   @default("medium")
  clusterId   String?
  sourceUrl   String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("seo_content_gaps")
}

model SeoBrand {
  id                 String   @id @default(cuid())
  tenantId           String
  brandName          String
  businessName       String?
  tagline            String?
  logoUrl            String?
  websiteUrl         String?
  founderName        String?
  founderTitle       String?
  founderBio         String?
  founderImage       String?
  servicesJson       String?
  locationsJson      String?
  socialProfilesJson String?
  awardsJson         String?
  certificationsJson String?
  reviewsJson        String?
  industryKeywords   String?
  brandScore         Float    @default(0)
  consistencyScore   Float    @default(0)
  schemaJson         String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("seo_brand")
}

model SeoSearchConsole {
  id                  String   @id @default(cuid())
  tenantId            String
  fetchedAt           DateTime @default(now())
  dateRange           String
  totalClicks         Int      @default(0)
  totalImpressions    Int      @default(0)
  avgCtr              Float    @default(0)
  avgPosition         Float    @default(0)
  topPagesJson        String?
  topQueriesJson      String?
  rankingDropsJson    String?
  cannibalizationJson String?
  lowCtrPagesJson     String?
  connected           Boolean  @default(false)
  siteUrl             String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("seo_search_console")
}

model SeoAutomationLog {
  id          String   @id @default(cuid())
  tenantId    String
  action      String
  pageId      String?
  pageType    String?
  url         String?
  before      String?
  after       String?
  status      String   @default("success")
  triggeredBy String   @default("auto")
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("seo_automation_logs")
}
