# KarmaKoders environment template. Copy to .env.local and fill in values.
# Never commit real values. Descriptions and formats: docs/ENV.md.
# Local development AND tests use .env.local, with DATABASE_URL pointing to the Neon dev branch.
# NODE_ENV, VERCEL_ENV and VERCEL_URL are set by the runtime/platform and are not listed here.

# --- Database (Neon PostgreSQL via Prisma 7) ---
# Pooled URL (host contains -pooler): app runtime and tests.
DATABASE_URL=
# Direct (non-pooled) URL: Prisma CLI migrate commands only. Optional; falls back to DATABASE_URL.
DIRECT_URL=

# --- App URLs ---
APP_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# --- Launch switch: "true" or "false" (unset = false, pre-launch) ---
SIGN_APP_ENABLED=

# --- CMS staff auth (NextAuth) ---
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# --- Customer auth + signer tokens (Sign / platform) ---
SESSION_SECRET=
TOKEN_PEPPER=

# --- Files: Sign uses private Cloudflare R2 + AES-256-GCM; UploadThing is CMS-only ---
FILE_ENCRYPTION_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
UPLOADTHING_TOKEN=

# --- Rate limiting (Upstash; required in production) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Background jobs (Inngest) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- PDF render service ---
PDF_SERVICE_URL=
PDF_SERVICE_SECRET=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=
MAIL_FROM=

# --- Paddle billing ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=
PADDLE_PRICE_CREDITS_10=
PADDLE_PRICE_CREDITS_30=
PADDLE_PRICE_SIGN_PRO_MONTHLY=
PADDLE_PRICE_SIGN_PRO_YEARLY=
PADDLE_PRICE_ALL_ACCESS_MONTHLY=
PADDLE_PRICE_ALL_ACCESS_YEARLY=

# --- Observability, analytics, staff ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
ANALYTICS_SALT=
ADMIN_EMAILS=

# --- Site / marketing ---
NEXT_PUBLIC_CAL_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_US_PHONE=
NEXT_PUBLIC_IMAGE_COMPRESSOR_API=
LEAD_WEBHOOK_URL=
CRON_SECRET=

# --- SEO / Google ---
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_GSC_CREDENTIALS=
GOOGLE_INDEXING_CLIENT_EMAIL=
GOOGLE_INDEXING_PRIVATE_KEY=
GSC_ACCESS_TOKEN=

# --- Free tools: domain registrars + FX ---
FX_RATES_JSON=
HOSTINGER_API_TOKEN=
HOSTINGER_API_BASE_URL=
HOSTINGER_CATALOG_PREFIX=
GODADDY_PAT=
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_API_BASE_URL=
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
PORKBUN_API_SECRET=
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_API_URL=
